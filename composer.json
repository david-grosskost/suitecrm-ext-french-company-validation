{
    "name": "david-grosskost/suitecrm-ext-french-company-validation",
    "description": "Contrôles des entreprises françaises sur les comptes SuiteCRM : SIRET et code NAF (extension de french-company-fields).",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.26"
    },
    "autoload-dev": {
        "classmap": ["legacy/include/"],
        "psr-4": {
            "App\\Extension\\FrenchCompanyValidation\\backend\\": "backend/",
            "SuiteCrmExt\\FrenchCompanyValidation\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
